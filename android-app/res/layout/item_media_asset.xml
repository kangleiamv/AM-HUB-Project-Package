<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Badge & Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/item_type_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_active"
            android:text="IMAGE"
            android:textColor="@color/accent_green"
            android:textSize="9sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp" />

        <TextView
            android:id="@+id/item_filename"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="asset.png"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="12sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Specs Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_specs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#14FFFFFF"
            android:text="1080x1920"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/item_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#14FFFFFF"
            android:text="1.88 MB"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <!-- Image Preview Thumbnail (Visible for images) -->
    <ImageView
        android:id="@+id/item_image_preview"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        android:scaleType="centerCrop"
        android:background="#060913"
        android:visibility="gone" />

    <!-- Advanced Custom Video Player Frame (Visible for video assets) -->
    <FrameLayout
        android:id="@+id/item_video_frame"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp"
        android:background="#02040A"
        android:visibility="gone">

        <VideoView
            android:id="@+id/item_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Poster Thumbnail -->
        <ImageView
            android:id="@+id/item_video_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#060913" />

        <!-- Center Overlay with Glowing Circle Play Button & Spinner -->
        <FrameLayout
            android:id="@+id/item_video_center_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center">

            <Button
                android:id="@+id/item_btn_center_play"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_play"
                android:text="▶"
                android:textColor="@color/accent_green"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/item_video_spinner"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Bottom Custom Controls Bar -->
        <LinearLayout
            android:id="@+id/item_video_controls_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_video_bottom_bar"
            android:orientation="vertical"
            android:padding="6dp">

            <!-- Scrubber SeekBar -->
            <SeekBar
                android:id="@+id/item_video_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progress="0"
                android:paddingHorizontal="4dp" />

            <!-- Controls Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/item_btn_play_toggle"
                    android:layout_width="38dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_button_accent"
                    android:text="▶"
                    android:textColor="#080B14"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/item_btn_rewind"
                    android:layout_width="48dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="-5s"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/item_btn_forward"
                    android:layout_width="48dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="+5s"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/item_video_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="0:00 / 0:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/item_btn_replay"
                    android:layout_width="36dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="🔄"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Audio Player Controls (Visible for audio) -->
    <LinearLayout
        android:id="@+id/item_audio_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/item_audio_play"
            android:layout_width="50dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_button_accent"
            android:text="▶"
            android:textColor="#080B14"
            android:textStyle="bold"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/item_audio_seekbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp" />

        <TextView
            android:id="@+id/item_audio_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Action Button -->
    <Button
        android:id="@+id/item_btn_download"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_secondary"
        android:text="⬇ Download Asset"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />
</LinearLayout>
